---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import FloatingCta from '../components/FloatingCta.astro';
import PartnerBadge from '../components/PartnerBadge.astro';

interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'about' | 'contact' | 'reading' | 'playing';
  /** Fixed "Let's Work Together" link. Not shown on the contact page. */
  floatingCta?: boolean;
}

const { title, description, current, floatingCta = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <SiteHeader current={current} />
    <slot />
    {floatingCta && <FloatingCta />}
    <PartnerBadge />
  </body>
</html>
