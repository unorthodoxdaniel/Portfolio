---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoIntro from '../components/PhotoIntro.astro';
import AboutSection from '../components/AboutSection.astro';
import NowCard from '../components/NowCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
  title="Daniel Abudu | About Me"
  description="I partner with marketing teams and founders to create web experiences they can truly own and control. As a Certified Webflow Expert, I combine design skills with technical expertise to build websites that drive business growth and ROI.My multidisciplinary background in Product, Graphic Design and Computer Science enables me to bridge the gap between aesthetics and functionality, ensuring your website not only looks great but serves as a powerful business tool."
  current="about"
>
  <PhotoIntro
    heading="Hi, I'm Daniel Abudu."
    level="h1"
    photo={{
      src: '/images/62d2c382919b1440d81e431b_Daniel-9---Copy-1.jpg',
      srcset:
        '/images/62d2c382919b1440d81e431b_Daniel-9---Copy-1-p-500.jpg 500w, /images/62d2c382919b1440d81e431b_Daniel-9---Copy-1-p-800.jpg 800w, /images/62d2c382919b1440d81e431b_Daniel-9---Copy-1.jpg 1072w',
    }}
  >
    <p>I partner with marketing teams and founders to create web experiences they can truly own and control. As a Certified Webflow Expert, I combine design skills with technical expertise to build websites that drive business growth and ROI.</p>
    <p>My multidisciplinary background in Product, Graphic Design and Computer Science enables me to bridge the gap between aesthetics and functionality, ensuring your website not only looks great but serves as a powerful business tool.</p>
    <p>I specialize in empowering teams to take control of their digital presence, eliminating the traditional dependencies on development teams for website updates and changes.</p>
  </PhotoIntro>

  <AboutSection heading="Experience">
    <p class="link-row"><a href="#">View my Linkedin</a></p>
  </AboutSection>

  <AboutSection heading="Ice Breakers">
    <div class="ice-text">
      <p>I'm currently a digital nomad, exploring where I can, when I can.</p>
      <p>In my spare time, I read (*coughs listen to) books so I can learn as much as I can about life beyond work. I also recently became a casual gamer.</p>
      <p>I love movies too! I'm a big comic book character guy and I'm usually the first in the cinemas to see those movies.</p>
      <p>I also really love going to the gym! Slowly grinding to get to 10+ pull ups (I'm a heavy guy) and 100kg DB bench press. In the meantime, I try to hit 10k+ steps a day, watch what I eat, and workout consistently to compensate for an otherwise sedentary lifestyle.</p>
      <p>I'm also a big tech guy. I love gadgets and gizmos and hoping to one day set up my dream space with random shit I don't need 🤣.</p>
    </div>
    <div class="now">
      <NowCard
        label="📚 Currently Reading:"
        title="Americanah"
        image="/images/512-txQ0IL._SL500_.webp"
        alt="Americanah"
        linkLabel="See other books I've explored"
        linkHref="/reading"
      />
      <NowCard
        label="🎮 Currently Playing:"
        title="Dispatch"
        image="/images/Dispatch_game_poster.webp"
        alt="Dispatch"
        linkLabel="See other games I've played"
        linkHref="/playing"
      />
    </div>
  </AboutSection>

  <SiteFooter />
</BaseLayout>

<style>
  .link-row {
    color: #ccc;
  }

  .link-row a {
    color: #fff;
  }

  /* the personal copy sits in a div in the legacy page, so it keeps regular weight and 1rem text */
  .ice-text {
    grid-column: span 2;
  }

  .ice-text p {
    font-size: 1rem;
    font-weight: 400;
    line-height: inherit;
  }

  /* paragraphs are separated by one blank line, as the legacy line breaks were */
  .ice-text p + p {
    margin-top: 1lh;
  }

  .now {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media screen and (max-width: 767px) {
    .ice-text {
      grid-column: span 1;
    }
  }
</style>
