---
/* Titled section of the About page: a heading above a three-column grid. */
interface Props {
  heading: string;
}

const { heading } = Astro.props;
---

<section class="about-section">
  <div class="container">
    <h2>{heading}</h2>
    <div class="grid"><slot /></div>
  </div>
</section>

<style>
  h2 {
    font-size: 3rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    /* two rows, as in the legacy grid (the second is empty) */
    grid-template-rows: auto auto;
    gap: 1.5rem;
    margin-top: 1rem;
    font-size: 1rem;
    line-height: 150%;
  }

  @media screen and (max-width: 991px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (max-width: 767px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 479px) {
    h2 {
      font-size: 1.5rem;
    }
  }
</style>
