---
import ArrowButton from './ArrowButton.astro';

interface Props {
  heading: string;
  ctaLabel: string;
  ctaHref: string;
  photo: { src: string; srcset?: string };
}

const { heading, ctaLabel, ctaHref, photo } = Astro.props;
---

<section class="hero">
  <div class="container">
    <div class="layout">
      <div class="text">
        <h3>{heading}</h3>
        <div class="body"><slot /></div>
        <ArrowButton href={ctaHref}>{ctaLabel}</ArrowButton>
      </div>
      <div class="photo">
        <img src={photo.src} srcset={photo.srcset} sizes="100vw" alt="" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    /* two rows, as in the legacy grid (the second is empty on desktop) */
    grid-template-rows: auto auto;
    gap: 16px;
  }

  h3 {
    font-size: 2rem;
  }

  .body {
    margin-top: 1.25rem;
    margin-bottom: 2rem;
    color: #ccc;
  }

  .photo {
    position: relative;
  }

  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  @media screen and (max-width: 991px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .photo {
      order: -1;
      padding-top: 50%;
    }
  }

  @media screen and (max-width: 479px) {
    h3 {
      font-size: 1.5rem;
    }
  }
</style>
