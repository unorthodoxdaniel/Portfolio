---
/* Fixed vertical "Premium Partner" badge on the right edge of the viewport. */
---

<div class="partner-badge">
  <img src="/images/premium_partner_badge_vertical_black.webp" alt="" />
</div>

<style>
  .partner-badge {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: 5;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    width: 2rem;
    pointer-events: none;
  }
</style>
