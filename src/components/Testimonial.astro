---
import type { CollectionEntry } from 'astro:content';
import { assetUrl, posterUrl, videoMime } from '../lib/media';

interface Props {
  testimonial: CollectionEntry<'testimonials'>;
}

const { data } = Astro.props.testimonial;
const roleLine = [data.role, data.organization].filter(Boolean).join(', ');
const poster = data.video ? posterUrl(data.video) : undefined;
---

{
  data.video ? (
    <figure class="video-testimonial">
      <div class="frame">
        <video controls playsinline preload="none" poster={poster}>
          {data.video.sources.map((src) => (
            <source src={src} type={videoMime(src)} />
          ))}
        </video>
      </div>
      {data.video.caption && <figcaption>{data.video.caption}</figcaption>}
    </figure>
  ) : (
    <blockquote class="testimonial">
      <p class="quote">{data.quote}</p>
      <footer class="author">
        {
          data.image && (
            <span class="avatar">
              <img src={assetUrl(data.image)} alt="" loading="lazy" />
            </span>
          )
        }
        <span class="details">
          <span class="name">{data.author}</span>
          {roleLine && <span>{roleLine}</span>}
          {data.relationship && <span>{data.relationship}</span>}
        </span>
      </footer>
    </blockquote>
  )
}

<style>
  .testimonial {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    margin: 0;
    text-align: left;
  }

  .quote {
    font-size: 1.5rem;
  }

  .author {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .avatar {
    position: relative;
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    overflow: hidden;
    border-radius: 50%;
  }

  .avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .details {
    display: flex;
    flex-direction: column;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.4;
  }

  .name {
    font-weight: 500;
  }

  .video-testimonial {
    margin: 0;
  }

  .frame {
    position: relative;
    padding-top: 56.25%;
  }

  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 4px;
  }

  figcaption {
    color: #ccc;
    font-size: 0.875rem;
    text-align: center;
  }

  @media screen and (max-width: 767px) {
    .quote {
      font-size: 1.25rem;
    }
  }

  @media screen and (max-width: 479px) {
    .testimonial {
      width: 100%;
    }

    .quote {
      font-size: 1rem;
      line-height: 150%;
    }

    .author {
      align-items: flex-start;
    }

    .avatar {
      width: 4rem;
      height: 4rem;
    }
  }
</style>
